{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "instructions": [
    "AGENTS.md",
    ".opencode/instructions/*.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "question": "allow"
  }
}
